rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the current user the admin?
    function isAdmin() {
      return request.auth != null && (
        request.auth.email == 'fq.ingenieros.empresa@gmail.com' ||
        request.auth.uid == 'IkBbQ9TIwcMniKQynSfPotmCqz62'
      );
    }

    // Allow everything for admin users for now - we'll restrict later
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null;
    }
  }
}

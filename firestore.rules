rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the current user the admin?
    function isAdmin() {
      return request.auth != null && (
        request.auth.email == 'fq.ingenieros.empresa@gmail.com'
      );
    }

    // Helper: is the current user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: is the current user the owner of the document?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ADMIN ACCESS: Full read/write for admins
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Allow users to read their own data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Allow users to read their own enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Allow users to read their own exams
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Allow users to read their own certificates
    match /certificates/{certificateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Allow users to read payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
